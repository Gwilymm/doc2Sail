{#
    Partial pour afficher un bouton QR code avec DaisyUI

    Paramètres:
    - type: 'document', 'regatta', 'home', etc. (défaut: 'home')
    - id: ID de l'entité (optionnel, null par défaut)
    - label: Texte du bouton (défaut: 'Code QR')
    - btn_class: Classes CSS du bouton (défaut: 'btn-primary')
    - icon_only: Afficher uniquement l'icône (défaut: false)
    - size: Taille du bouton 'xs', 'sm', 'md', 'lg' (défaut: 'sm')
    - tooltip: Texte du tooltip (optionnel)

    Exemple d'utilisation:
    {% include 'qrcode/_button.html.twig' with {
        'type': 'regatta',
        'id': regatta.id,
        'label': 'Partager',
        'btn_class': 'btn-accent',
        'size': 'md'
    } %}
#}

{% set label = label|default('Code QR') %}
{% set type = type|default('home') %}
{% set id = id|default(null) %}
{% set icon_only = icon_only|default(false) %}
{% set size = size|default('sm') %}
{% set btn_class = btn_class|default('btn-primary') %}
{% set tooltip = tooltip|default(icon_only ? label : null) %}

<button
    type="button"
    class="btn {{ btn_class }} btn-{{ size }} {% if icon_only %}btn-square{% endif %}"
    onclick="loadQRCodeModal('{{ type }}', '{{ id }}')"
    {% if tooltip %}title="{{ tooltip }}" data-tip="{{ tooltip }}"{% endif %}>
    <svg xmlns="http://www.w3.org/2000/svg"
         class="h-5 w-5"
         fill="none"
         viewBox="0 0 24 24"
         stroke="currentColor">
        <path stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
    </svg>
    {% if not icon_only %}
        <span class="ml-1">{{ label }}</span>
    {% endif %}
</button>

<script>
    // Fonction pour charger la modal QR code (si elle n'existe pas déjà)
    if (typeof loadQRCodeModal !== 'function') {
        function loadQRCodeModal(type, id) {
            const url = id ? `/qrcode/modal/${type}/${id}` : `/qrcode/modal/${type}`;

            fetch(url)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.text();
                })
                .then(html => {
                    // Trouver ou créer le conteneur pour la modal
                    let container = document.getElementById('qrCodeModalContainer');
                    if (!container) {
                        container = document.createElement('div');
                        container.id = 'qrCodeModalContainer';
                        document.body.appendChild(container);
                    }

                    // Remplacer le contenu
                    container.innerHTML = html;

                    // Ouvrir la modal DaisyUI
                    const modal = document.getElementById('qrCodeModal');
                    if (modal) {
                        modal.showModal();
                    } else {
                        console.error('Modal QR code introuvable');
                    }
                })
                .catch(error => {
                    console.error('Erreur lors du chargement du QR code:', error);

                    // Afficher un toast d'erreur si la fonction existe
                    if (typeof showToast === 'function') {
                        showToast('Impossible de charger le QR code', 'error');
                    } else {
                        alert('Impossible de charger le QR code. Veuillez réessayer.');
                    }
                });
        }
    }
</script>
