<dialog id="qrCodeModal" class="modal" data-controller="qrcode-share" data-regatta-name="{{ regatta_name|e('html_attr') }}" data-regatta-dates="{{ regatta_dates|e('html_attr') }}">
	<div
		class="modal-box max-w-md">
		<!-- Header -->
		<div class="flex items-center justify-between mb-4">
			<h3 class="font-bold text-lg flex items-center gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewbox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/>
				</svg>
				Code QR
			</h3>
			<form method="dialog">
				<button class="btn btn-sm btn-circle btn-ghost">✕</button>
			</form>
		</div>

		<!-- QR Code Container -->
		<div class="flex justify-center mb-6">
			<div class="bg-white p-6 rounded-lg shadow-lg" data-qrcode-share-target="qrContainer">
				<img src="{{ qr_code_data_uri }}" alt="QR Code" class="w-40 sm:w-full max-w-xs mx-auto" data-qrcode-share-target="qrImage" id="qrCodeImage">
			</div>
		</div>

		<!-- Description -->
		{% if route_missing %}
			<div class="alert alert-warning mb-4">
				<strong>Avertissement:</strong>
				{{ error_message }}
			</div>
		{% endif %}

		<div class="alert alert-info mb-4">
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
			</svg>
			<span class="text-sm">Scannez ce code QR pour accéder directement au contenu</span>
		</div>

		<!-- URL Display -->
		<div class="form-control mb-6">
			<label class="label">
				<span class="label-text font-semibold">Lien</span>
			</label>
			<div class="join w-full">
				<input type="text" class="input input-bordered input-sm join-item flex-1 font-mono text-xs" value="{{ url }}" readonly data-qrcode-share-target="urlInput" id="qrCodeUrl">
				<button class="btn btn-sm btn-primary join-item" data-action="click->qrcode-share#copyUrl touchend->qrcode-share#copyUrl" title="Copier l'URL" type="button">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
					</svg>
				</button>
			</div>
		</div>

		<!-- Action Buttons -->
		<div class="divider">Actions</div>

		<div class="grid grid-cols-2 gap-2 mb-4">
			<button type="button" class="btn btn-outline btn-primary btn-sm" data-action="click->qrcode-share#print touchend->qrcode-share#print">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
				</svg>
				Imprimer
			</button>

			<button type="button" class="btn btn-outline btn-secondary btn-sm" data-action="click->qrcode-share#download touchend->qrcode-share#download">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
				</svg>
				Télécharger
			</button>
		</div>

		<!-- Share Buttons -->
		<div class="divider">Partager</div>

		<div class="flex flex-col sm:flex-row gap-2 justify-center">
			<button type="button" class="btn btn-success btn-sm" data-action="click->qrcode-share#shareWhatsApp touchend->qrcode-share#shareWhatsApp" title="Partager sur WhatsApp" data-qrcode-share-target="shareWhatsAppButton">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewbox="0 0 24 24">
					<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
				</svg>
				WhatsApp
			</button>

			<button type="button" class="btn btn-info btn-sm" data-action="click->qrcode-share#shareEmail touchend->qrcode-share#shareEmail" title="Partager par email" data-qrcode-share-target="shareEmailButton">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
				</svg>
				Email
			</button>

			<button type="button" class="btn btn-accent btn-sm" data-action="click->qrcode-share#shareNative touchend->qrcode-share#shareNative" title="Partager" data-qrcode-share-target="shareButton">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
				</svg>
				Partager
			</button>
		</div>

		<!-- Close button -->
		<div class="modal-action">
			<form method="dialog">
				<button class="btn">Fermer</button>
			</form>
		</div>
	</div>

	<!-- Backdrop -->
	<form method="dialog" class="modal-backdrop">
		<button>close</button>
	</form>
</dialog>

<style>
	@media print
	{
		body *
		{visibility:hidden
		}

		#qrCodeImage,
		#qrCodeImage *
		{visibility:visible
		}

		#qrCodeImage
		{position:absolute;left:50%;top:50%;transform:translate(-50%, -50%)
		}
	}
</style>
