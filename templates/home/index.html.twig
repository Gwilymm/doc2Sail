							<h3 class="card-title text-2xl mb-3">{{ 'home.features.secure.title'|trans }}</h3>
							<p class="text-base-content/70">
								{{ 'home.features.secure.description'|trans }}
							</p>
							<div class="badge badge-secondary badge-lg mt-4">{{ 'home.features.secure.badge'|trans }}</div>
