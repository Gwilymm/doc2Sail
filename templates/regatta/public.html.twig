{% extends 'base.html.twig' %}

{% block title %}{{ regatta.name }} - Doc2Sail{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8 max-w-7xl">
    <!-- Header -->
    <div class="mb-8">
        <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
                <span class="text-5xl">⛵</span>
                <div>
                    <h1 class="text-4xl font-bold text-primary">{{ regatta.name }}</h1>
                    <p class="text-sm text-base-content/70">{{ regatta.startDate|date('d/m/Y') }} - {{ regatta.endDate|date('d/m/Y') }}</p>
                    {% if regatta.description %}
                        <p class="text-sm text-base-content/60 mt-2">{{ regatta.description }}</p>
                    {% endif %}
                </div>
            </div>
        </div>
        
        <!-- Search Bar -->
        <div class="form-control">
            <input type="text" id="searchInput" placeholder="🔍 Rechercher un document..." class="input input-bordered w-full" />
        </div>
    </div>

    <!-- Documents Grid -->
    <div class="mb-4 flex justify-between items-center">
        <h2 class="text-2xl font-bold">
            Documents 
            <span class="badge badge-primary">{{ documents|length }}</span>
        </h2>
    </div>

    <div id="documentsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for document in documents %}
            <div class="card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow document-card">
                <div class="card-body">
                    <div class="flex items-start justify-between mb-3">
                        <div class="flex-1">
                            <h3 class="card-title text-lg">{{ document.name }}</h3>
                            {% if document.description %}
                                <p class="text-sm text-base-content/70 mt-1">{{ document.description }}</p>
                            {% endif %}
                        </div>
                        
                        <!-- File Type Icon -->
                        <div class="avatar placeholder">
                            <div class="bg-primary text-primary-content rounded-lg w-12 h-12 flex items-center justify-center">
                                <span class="text-2xl">
                                    {% if 'pdf' in document.mimeType %}
                                        📄
                                    {% elseif 'image' in document.mimeType %}
                                        🖼️
                                    {% elseif 'word' in document.mimeType or 'document' in document.mimeType %}
                                        📝
                                    {% elseif 'excel' in document.mimeType or 'sheet' in document.mimeType %}
                                        📊
                                    {% else %}
                                        📁
                                    {% endif %}
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="divider my-2"></div>

                    <div class="flex items-center justify-between text-xs text-base-content/70 mb-4">
                        <span class="badge badge-outline">{{ document.formattedSize }}</span>
                        <span>{{ document.uploadedAt|date('d/m/Y') }}</span>
                    </div>

                    <!-- Public Actions - View & Download only -->
                    <div class="card-actions justify-end gap-2">
                        <a href="{{ path('app_document_view', {id: document.id}) }}" target="_blank" class="btn btn-sm btn-outline flex-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                            Voir
                        </a>
                        <a href="{{ path('app_document_download', {id: document.id}) }}" class="btn btn-sm btn-primary flex-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                            </svg>
                            Télécharger
                        </a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-span-full text-center py-16">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24 mx-auto mb-4 text-base-content/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <p class="text-xl text-base-content/50">Aucun document disponible</p>
                <p class="text-sm text-base-content/40 mt-2">Les documents seront affichés ici quand ils seront ajoutés</p>
            </div>
        {% endfor %}
    </div>
</div>

<!-- Toast Container -->
<div id="toastContainer" class="toast toast-top toast-end z-50"></div>

<!-- Install PWA Button -->
<button id="installBtn" class="btn btn-primary fixed bottom-4 right-4 hidden shadow-lg">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
    </svg>
    Installer l'app
</button>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
// Search
document.getElementById('searchInput').addEventListener('input', (e) => {
    const search = e.target.value.toLowerCase();
    document.querySelectorAll('.document-card').forEach(card => {
        const title = card.querySelector('.card-title').textContent.toLowerCase();
        const desc = card.querySelector('p')?.textContent.toLowerCase() || '';
        card.style.display = (title.includes(search) || desc.includes(search)) ? 'block' : 'none';
    });
});

// PWA Install
let deferredPrompt;
const installBtn = document.getElementById('installBtn');

window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    installBtn.classList.remove('hidden');
});

installBtn.addEventListener('click', async () => {
    if (deferredPrompt) {
        deferredPrompt.prompt();
        const { outcome } = await deferredPrompt.userChoice;
        deferredPrompt = null;
        installBtn.classList.add('hidden');
    }
});
</script>
{% endblock %}
