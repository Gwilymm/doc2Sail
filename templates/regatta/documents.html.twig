    // Copy public URL
    function copyPublicUrl() {
        const input = document.getElementById('publicUrl');
        input.select();
        document.execCommand('copy');

        // Show toast
        const toast = document.createElement('div');
        toast.className = 'alert alert-success';
        toast.innerHTML = '<span>URL copiée dans le presse-papier!</span>';
        document.getElementById('toastContainer').appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
    }

    // Category Filter
    function filterCategories() {
        const checkboxes = document.querySelectorAll('#categoryFilters input[type="checkbox"]');
        const selectedCategories = Array.from(checkboxes)
            .filter(cb => cb.checked)
            .map(cb => cb.value);

        // Si aucune checkbox n'est cochée, tout masquer
        const showAll = selectedCategories.length === 0;

        document.querySelectorAll('.category-section').forEach(section => {
            const category = section.getAttribute('data-category');
            if (showAll) {
                section.style.display = 'block';
            } else {
                section.style.display = selectedCategories.includes(category) ? 'block' : 'none';
            }
        });
    }

    // Initialiser : tout masquer par défaut
    document.addEventListener('DOMContentLoaded', () => {
        filterCategories();
    });

    // Invite co-owner
    function loadQRCodeModal(type, id) {
        const url = id ? `/qrcode/modal/${type}/${id}` : `/qrcode/modal/${type}`;

        fetch(url)
            .then(response => response.text())
            .then(html => {
                // Supprimer l'ancienne modal si elle existe
                const container = document.getElementById('qrCodeModalContainer');
                container.innerHTML = html;

                // Ouvrir la modal DaisyUI
                const modal = document.getElementById('qrCodeModal');
                if (modal) {
                    modal.showModal();
                }
            })
            .catch(error => {
                console.error('Erreur lors du chargement du QR code:', error);
                showToast('Impossible de charger le QR code', 'error');
            });
    }

    async function inviteCoOwner() {
        const email = document.getElementById('inviteEmail').value;

        if (!email || !email.includes('@')) {
            showToast('Veuillez entrer une adresse email valide', 'error');
            return;
        }

        try {
            const response = await fetch('/regatta/{{ regatta.id }}/invite', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: email })
            });

            const result = await response.json();

            if (result.success) {
                showToast(result.message, 'success');
                inviteCoOwnerModal.close();
                document.getElementById('inviteEmail').value = '';
            } else {
                showToast(result.error || 'Erreur lors de l\'envoi de l\'invitation', 'error');
                if (result.debug_url) {
                    console.log('Debug URL:', result.debug_url);
                }
            }
        } catch (error) {
            showToast('Erreur lors de l\'envoi de l\'invitation', 'error');
            console.error(error);
        }
    }
</script>
{% endblock %}
