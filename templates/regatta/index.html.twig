{% extends 'base.html.twig' %}
{% trans_default_domain 'regatta' %}

{% block title %}
	{{ 'regatta.title'|trans }}
{% endblock %}

{% block body %}
	{% include '_navbar.html.twig' %}

	<div class="container mx-auto px-4 py-8 max-w-7xl" data-controller="regatta ui">
		<div class="mb-8">
			<div class="flex items-center justify-between mb-4">
				<div class="flex items-center gap-3">
					<span class="text-5xl">⚙️</span>
					<div>
						<h1 class="text-4xl font-bold text-primary">{{ 'regatta.title'|trans }}</h1>
					</div>
				</div>

				<!-- Desktop buttons - hidden on mobile -->
				<div class="hidden md:flex gap-2">

					<button data-open-dialog="#createRegattaModal" class="btn btn-primary btn-sm">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
						</svg>
						{{ 'regatta.new_regatta'|trans }}
					</button>
				</div>
			</div>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
			{% for regatta in regattas %}
				<div class="card bg-base-100 shadow-xl">
					<div class="card-body">
						<h2 class="card-title text-primary">{{ regatta.name }}</h2>
						<p class="text-sm">{{ regatta.startDate|date('d/m/Y') }}
							-
							{{ regatta.endDate|date('d/m/Y') }}</p>
						<p class="text-sm">{{ regatta.documents|length }}
							{{ 'regatta.documents_count'|trans }}</p>
						<div class="card-actions justify-end mt-4 gap-2">
							<button data-action="click->regatta#delete" data-regatta-id="{{ regatta.id }}" data-regatta-name="{{ regatta.name|e('html_attr') }}" class="btn btn-error btn-sm">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
								</svg>
								{{ 'regatta.actions.delete'|trans }}
							</button>
							<a href="{{ path('app_regatta_documents', {id: regatta.id}) }}" class="btn btn-primary btn-sm">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
								</svg>
								{{ 'regatta.actions.manage'|trans }}
							</a>
						</div>
					</div>
				</div>
			{% else %}
				<div class="col-span-full text-center py-16">
					<p class="text-xl text-base-content/50">{{ 'regatta.no_regattas'|trans }}</p>
					<button data-open-dialog="#createRegattaModal" class="btn btn-primary mt-4">{{ 'regatta.create_first'|trans }}</button>
				</div>
			{% endfor %}
		</div>
	</div>

	<!-- FAB (Floating Action Button) - Visible only on mobile -->
	<div class="md:hidden {% if ux_is_native() %}hidden{% endif %}">
		<button data-open-dialog="#createRegattaModal" class="btn btn-lg btn-circle btn-primary shadow-xl fixed bottom-6 right-6 z-50">
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
				<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
			</svg>
		</button>
	</div>

	<dialog id="createRegattaModal" class="modal">
		<div class="modal-box">
			<button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" data-close-dialog="#createRegattaModal">✕</button>
			<h3 class="font-bold text-lg mb-4">{{ 'regatta.modal.create_title'|trans }}</h3>
			<form id="createRegattaForm" data-action="submit->regatta#submitCreateRegatta">
				<div class="form-control mb-4">
					<label class="label">
						<span class="label-text">{{ 'regatta.form.name'|trans }}
							*</span>
					</label>
					<input type="text" name="name" class="input input-bordered" required/>
				</div>
				<div class="grid grid-cols-2 gap-4 mb-4">
					<div class="form-control">
						<label class="label">
							<span class="label-text">{{ 'regatta.form.start_date'|trans }}
								*</span>
						</label>
						<input type="date" name="startDate" class="input input-bordered" required/>
					</div>
					<div class="form-control">
						<label class="label">
							<span class="label-text">{{ 'regatta.form.end_date'|trans }}
								*</span>
						</label>
						<input type="date" name="endDate" class="input input-bordered" required/>
					</div>
				</div>
				<div class="form-control mb-4">
					<label class="label">
						<span class="label-text">{{ 'regatta.form.description'|trans }}</span>
					</label>
					<textarea name="description" class="textarea textarea-bordered" rows="3"></textarea>
				</div>
				<div class="modal-action">
					<button type="button" class="btn" data-close-dialog="#createRegattaModal">{{ 'regatta.modal.cancel'|trans }}</button>
					<button type="submit" class="btn btn-primary">{{ 'regatta.modal.create'|trans }}</button>
				</div>
			</form>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button type="submit">close</button>
		</form>
	</dialog>

	<div id="toastContainer" class="toast toast-top toast-end z-50"></div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	{# Regatta actions handled by Stimulus controllers: assets/controllers/regatta_controller.js and assets/controllers/ui_controller.js #}
{% endblock %}
