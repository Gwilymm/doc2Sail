{% extends 'base.html.twig' %}

{% block title %}
    {{ document.name }} - Doc2Sail
{% endblock %}

{% block body %}
    {% include '_navbar.html.twig' %}

    <div class="container mx-auto px-4 py-6 max-w-screen-xl space-y-6">

        <section class="card bg-base-100 shadow relative">
    <div class="card-body px-4 py-3 space-y-3">

        <!-- Bouton retour (haut droite) -->
        <div class="absolute top-3 right-3">
            {% if document.regatta %}
                <a href="{{ path('app_regatta_documents', {'id': document.regatta.id}) }}"
                   class="btn btn-ghost btn-xs rounded-full">
                    ← Retour
                </a>
            {% else %}
                <a href="{{ path('app_home') }}"
                   class="btn btn-ghost btn-xs rounded-full">
                    ← Accueil
                </a>
            {% endif %}
        </div>

        <!-- Titre -->
        <h2 class="text-lg font-semibold truncate pr-16">
            {{ document.name }}
        </h2>

        <!-- Description (optionnelle) -->
        {% if document.description %}
            <p class="text-xs text-base-content/60">
                {{ document.description }}
            </p>
        {% endif %}

        <!-- Infos compactes en deux lignes -->
        <div class="grid grid-cols-2 gap-y-1 text-xs">
            <div><strong>Taille :</strong> {{ document.getFormattedSize() }}</div>
            <div><strong>Type :</strong> {{ document.mimeType }}</div>

            <div><strong>Ajouté :</strong> {{ document.uploadedAt|date('d/m/Y H:i') }}</div>
            <div><strong>Catégorie :</strong> {{ document.category }}</div>
        </div>

        <!-- Boutons Desktop -->
        <div class="hidden lg:flex justify-start gap-3 pt-2">
            <a href="{{ downloadUrl }}" class="btn btn-primary btn-sm">Télécharger</a>
            <a href="{{ fileUrl }}" target="_blank" rel="noopener noreferrer"
               class="btn btn-outline btn-sm">
                Ouvrir (raw)
            </a>
        </div>
    </div>
</section>


<!-- ACTIONS MOBILE -->
<section class="lg:hidden grid grid-cols-1 gap-3 mt-3 mx-auto">
    <a href="{{ downloadUrl }}" class="btn btn-primary w-full">Télécharger</a>

    <a href="{{ fileUrl }}" 
       target="_blank"
       rel="noopener noreferrer"
       class="btn btn-outline w-full">
       Ouvrir (raw)
    </a>
</section>



        <!-- APERÇU DOCUMENT (MAJORITAIRE) -->
        <section class="card bg-base-100 shadow overflow-hidden">
            <div class="card-body p-2 md:p-4">
                <div class="w-full mx-auto ">

                {% if isImage %}
                    <!-- Image -->
                    <div class="w-full flex justify-center bg-base-200 p-2 rounded-lg overflow-hidden">
                        <img src="{{ fileUrl }}" alt="{{ document.name }}" class="w-full h-[55vh] lg:h-[80vh] object-contain"/>
                    </div>

                {% elseif isPdf %}
                    <!-- PDF Viewer -->
                    <div class="relative w-full h-[55vh] lg:h-[80vh] bg-base-200 rounded-lg overflow-hidden">
                        <iframe 
                            src="/pdfjs/web/viewer.html?file={{ fileUrl|url_encode }}#zoom=auto&sidebar=0"
                            class="absolute inset-0 w-full h-full rounded-lg" 
                            frameborder="0"
                        ></iframe>
                    </div>

                    {# Desktop actions will be placed after the viewer block so they are visible for all file types #}

                {% elseif isOffice %}
                    <!-- Office Viewer -->
                    <div class="relative w-full h-[55vh] lg:h-[80vh] bg-base-200 rounded-lg overflow-hidden">
                        <iframe 
                            src="https://view.officeapps.live.com/op/embed.aspx?src={{ fileUrl|url_encode }}" 
                            class="absolute inset-0 w-full h-full" 
                            frameborder="0"
                        ></iframe>
                    </div>
				{% elseif isTxt %}
               
       <div class="relative w-full h-[55vh] lg:h-[80vh] bg-base-200 rounded-lg overflow-hidden">
                        <iframe 
                            src="{{ fileUrl}}" 
                            class="absolute inset-0 w-full h-full" 
                            frameborder="0"
                        ></iframe>
                    </div>



                {% else %}
                    <!-- Format non supporté -->
                    <div class="p-6 text-center space-y-3">
                        <p class="text-base">Format non prévisualisable.</p>
                        <a href="{{ downloadUrl }}" class="btn btn-primary">Télécharger</a>
                    </div>
                {% endif %}

            </div>
                </div>
                {# Desktop inline actions (hidden on mobile) #}
                    
                </section>

       
        

        <!-- SIGNATURE (SECONDAIRE) -->
        <section class="card bg-base-100 shadow">
            <div class="card-body space-y-4">

                <h3 class="font-semibold">Signature</h3>

                <div class="relative w-full h-[30vh] lg:h-[20vh] bg-base-200 rounded-lg overflow-hidden">
                    <iframe 
                        id="signFrame"
                        src="https://sign.doc2sail.com/embed?doc={{ fileUrl|url_encode }}"
                        class="absolute inset-0 w-full h-full"
                        frameborder="0"
                    ></iframe>
                </div>

                <div id="signEmbedFallback" class="alert alert-warning hidden">
                    <span>Impossible d'afficher la signature intégrée.</span>
                    <a href="https://sign.doc2sail.com/embed?doc={{ fileUrl|url_encode }}" class="btn btn-primary btn-sm mt-2">
                        Ouvrir dans un nouvel onglet
                    </a>
                </div>

            </div>
        </section>

        <!-- DÉTAILS -->
       

    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script nonce="{{ csp_nonce('script') }}">
        document.addEventListener('DOMContentLoaded', () => {
            const frame = document.getElementById('signFrame');
            const fallback = document.getElementById('signEmbedFallback');
            if (!frame || !fallback) return;

            let loaded = false;
            const timer = setTimeout(() => {
                if (!loaded) {
                    fallback.classList.remove('hidden');
                    frame.style.display = 'none';
                }
            }, 1500);

            frame.addEventListener('load', () => {
                loaded = true;
                clearTimeout(timer);
            });

            frame.addEventListener('error', () => {
                fallback.classList.remove('hidden');
                frame.style.display = 'none';
            });
        });
    </script>
{% endblock %}
