
{# 404 — étend la base et réutilise la navbar/footer #}
{% extends 'base.html.twig' %}
{% trans_default_domain 'base' %}

{% block stylesheets %}
        {{ parent() }}
        <style>
            /* Minimal keyframes for the ship + waves; layout handled by Tailwind + daisyUI */
            @keyframes sink{0%{transform:translateY(0) rotate(0deg)}40%{transform:translateY(-6px) rotate(-2deg)}70%{transform:translateY(12px) rotate(6deg)}100%{transform:translateY(0) rotate(0deg)}}
            @keyframes swim{0%{transform:translateX(0)}100%{transform:translateX(50%)}}
            @keyframes float{0%{transform:translateY(0);opacity:0.9}100%{transform:translateY(-18px);opacity:0}}
            .ship{transform-origin:50% 60%;animation:sink 6s ease-in-out infinite}
            .wave.w1{animation:swim 9s linear infinite}
            .wave.w2{animation:swim 12s linear infinite}
            .smoke{opacity:0.85;animation:float 3s linear infinite}
            /* 404 page specific tweaks */
            .error-card { background: linear-gradient(180deg, rgba(255,255,255,0.9), rgba(255,255,255,0.95)); }
            .media-frame { background: linear-gradient(180deg, rgba(0,0,0,0.03), rgba(0,0,0,0.02)); border-radius: 12px; overflow: hidden; }
            .media-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.0) 40%, rgba(0,0,0,0.06)); }
            .caption-muted { color: rgba(31,41,55,0.6); }
        </style>
{% endblock %}

{% block body %}
    {% include '_navbar.html.twig' %}

    <main class="mx-auto max-w-4xl px-6 py-12">
        <div class="card bg-base-200 p-8 rounded-lg shadow-lg error-card">
            <h1 class="text-4xl font-bold mb-2">{{ 'base.error404.title'|trans }}</h1>
            <p class="lead text-base-content/80 mb-6">{{ 'base.error404.message'|trans }}</p>

            <div class="scene relative h-64 sm:h-80 md:h-96 lg:h-[520px] overflow-hidden rounded-md bg-gradient-to-b from-base-300/30 to-base-300/10">
        
                <div class="ship-wrap absolute inset-0 pointer-events-none flex items-center justify-center">
                    {# Use the GIF from public/404.gif instead of the inline SVG. Responsive sizing + object-fit for good integration #}
                    <div class="w-11/12 md:w-4/5 lg:w-4/5 xl:w-3/4 max-w-[1400px]">
                        <div class="media-frame shadow-lg relative">
                            <div class="media-overlay" aria-hidden="true"></div>
                            <picture>
                                <source type="image/avif" srcset="{{ asset('404.avif') }}">
                                <source type="image/webp" srcset="{{ asset('404.webp') }}">
                                <img src="{{ asset('404.gif') }}" alt="404" class="w-full h-auto max-h-[340px] sm:max-h-[420px] md:max-h-[600px] lg:max-h-[720px] object-cover object-center block mx-auto" loading="lazy" decoding="async" />
                            </picture>
                        </div>
                        <div class="mt-4 px-4 text-center">
                            <p class="font-medium">{{ 'base.error404.suggestion'|trans({'%home%': path('app_home')}) }}</p>
                        </div>
                    </div>
                </div>
            </div>

                <div class="caption mt-6 text-base-content/80 flex flex-col md:flex-row items-center justify-between gap-4">
                    <div class="caption-text">
                        <p class="caption-muted mb-3">{{ 'base.error404.more_info'|trans }}</p>
                        <div class="flex gap-3">
                            <a class="btn btn-accent" href="{{ path('app_home') }}">{{ 'base.error404.home'|trans }}</a>
                            <a class="btn btn-ghost" href="{{ path('app_contact') }}">{{ 'base.error404.contact'|trans }}</a>
                        </div>
                    </div>
                    <div class="text-sm caption-muted">{{ 'base.error404.help_line'|trans }}</div>
                </div>
        </div>
    </main>
{% endblock %}
