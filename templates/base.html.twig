{% trans_default_domain 'base' %}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}" data-controller="theme">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">

		<title>
			{% block title %}
				{{ 'base.title'|trans }}
			{% endblock %}
		</title>

		<!-- Description + thème -->
		<meta name="description" content="{{ 'base.description'|trans({}, 'base') }}">
		<meta
		name="theme-color" content="#0284c7">

		<!-- Favicons -->
		<link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}">
		<link rel="icon" type="image/svg+xml" href="{{ asset('logo.svg') }}">
		<link rel="apple-touch-icon" href="{{ asset('icon-192.png') }}">
		<link rel="icon" type="image/png" sizes="32x32" href="{{ asset('favicon.png') }}">
		<link rel="apple-touch-icon" href="{{ asset('favicon.png') }}">
		<link rel="shortcut icon" href="{{ asset('favicon.png') }}">
		<link rel="icon" href="{{ asset('icon-512.png') }}" type="image/png" sizes="512x512">

		<meta name="mobile-web-app-capable" content="yes">
		<meta
		name="apple-mobile-web-app-status-bar-style" content="black-translucent">

		{# =========================
																								   🔗 META-TAGS POUR LE PARTAGE
																								   ========================= #}
		<meta property="og:type" content="website">
		<meta property="og:locale" content="fr_FR">
		<meta property="og:url" content="{{ app.request.uri }}">
		<meta property="og:site_name" content="Doc2Sail">

		<meta property="og:title" content="{% block og_title %}{{ 'base.title'|trans }}{% endblock %}">
		<meta property="og:description" content="{% block og_description %}{{ 'base.description'|trans({}, 'base') }}{% endblock %}">
		<meta property="og:image" content="{{ app.request.schemeAndHttpHost ~ asset('icon-192.png') }}">


		{% block stylesheets %}
			<link rel="manifest" href="{{ asset('manifest.json') }}">
			{{ encore_entry_link_tags('app') }}
		{% endblock %}

		{% block javascripts %}
			{% block importmap %}{{ importmap('app', {'nonce': csp_nonce('script')}) }}{% endblock %}
			{{ encore_entry_script_tags('app') }}
		{% endblock %}

		<!-- Theme Controller Script -->
		<script nonce="{{ csp_nonce('script') }}">

			( function ()
{





const theme = localStorage.getItem( 'theme' ) || 'light';
document.documentElement.setAttribute( 'data-theme', theme );





} )();
		</script>
		<script type="application/ld+json" nonce="{{ csp_nonce('script') }}">
			{
																						"@context": "https://schema.org",
																						"@type": "SoftwareApplication",
																						"name": "Doc2Sail",
																						"applicationCategory": "WebApplication",
																						"operatingSystem": "Any",
																						"description": "Application PWA française pour gérer et partager vos documents de régate de voile.",
																						"url": "https://doc2sail.com/",
																						"image": "https://doc2sail.com/icon-192.png",
																						"author": {
																						"@type": "Organization",
																						"name": "Doc2Sail"
																						}
																					}
		</script>
		<script type="application/ld+json" nonce="{{ csp_nonce('script') }}">
			{
																					"@context": "https://schema.org",
																					"@type": "Organization",
																					"name": "Doc2Sail",
																					"url": "https://doc2sail.com",
																					"logo": "https://doc2sail.com/favicon.png"
																					}
		</script>


	</head>

	<body class="bg-base-200 min-h-screen flex flex-col" data-controller="ui">
		<main class="flex-1"> {% block body %}{% endblock %}
			</main>

			{# Footer partial included on every page (sticky bottom via flex layout) #}
			{% include 'partials/footer.html.twig' %}

			<!-- Service Worker Registration -->
			<script nonce="{{ csp_nonce('script') }}">

				if ( 'serviceWorker' in navigator )
{





window.addEventListener( 'load', () => {





const isPublicPage = window.location.pathname.startsWith( '/r/' );
if ( isPublicPage )
{





console.log( '📍 Page publique détectée, SW spécifique sera chargé' );
return;





}
navigator.serviceWorker.getRegistrations().then( regs => regs.forEach( reg => reg.update() ) );
navigator.serviceWorker.register( '/sw.js' ).then( reg => {





console.log( '✅ Service Worker enregistré', reg );
window.addEventListener( 'beforeinstallprompt', e => {





console.log( '💾 PWA peut être installée' );
window.deferredPrompt = e;





} );





} ).catch( err => console.warn( '⚠️ Service Worker error:', err ) );





} );





}
else
{





console.log( '❌ Service Worker non supporté par ce navigateur' );





}
			</script>
		</body>
	</html>
