{% set currentRoute = app.request.attributes.get('_route') %}

<nav class="fixed inset-x-0 bottom-0 z-50 border-t border-base-300 bg-base-100/95 backdrop-blur supports-[backdrop-filter]:bg-base-100/80 pb-[env(safe-area-inset-bottom)] shadow-[0_-8px_24px_rgba(0,0,0,0.12)]" aria-label="Navigation mobile">
	<div class="grid grid-cols-3 h-16">
		<a href="{{ path('app_home') }}" class="flex flex-col items-center justify-center gap-1 text-xs font-semibold {% if currentRoute == 'app_home' %}text-primary{% else %}text-base-content/70{% endif %}">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1V10"/>
			</svg>
			<span>Accueil</span>
		</a>

		<a href="{{ path('app_regatta') }}" class="flex flex-col items-center justify-center gap-1 text-xs font-semibold {% if currentRoute starts with 'app_regatta' %}text-primary{% else %}text-base-content/70{% endif %}">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 19h18M5 17l4-12 4 12M9 5l8 12"/>
			</svg>
			<span>Régates</span>
		</a>

		{% if app.user %}
			<a href="{{ path('app_logout') }}" class="flex flex-col items-center justify-center gap-1 text-xs font-semibold text-base-content/70">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
				</svg>
				<span>Sortir</span>
			</a>
		{% else %}
			<a href="{{ path('app_login') }}" class="flex flex-col items-center justify-center gap-1 text-xs font-semibold {% if currentRoute == 'app_login' %}text-primary{% else %}text-base-content/70{% endif %}">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a3 3 0 013 3m3 0a6 6 0 01-7.743 5.743L11 18H8v3H5v-3H2v-3l6.257-6.257A6 6 0 1121 10z"/>
				</svg>
				<span>Connexion</span>
			</a>
		{% endif %}
	</div>
</nav>
