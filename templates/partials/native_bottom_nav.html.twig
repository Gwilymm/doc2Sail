{% trans_default_domain 'navbar' %}
{% set currentRoute = app.request.attributes.get('_route')|default('') %}

<style>
	.native-bottom-nav {
		position: fixed;
		left: 50%;
		right: auto;
		bottom: calc(14px + env(safe-area-inset-bottom, 0px));
		z-index: 2147483647;
		width: min(92vw, 390px);
		transform: translateX(-50%);
		isolation: isolate;
	}

	.native-bottom-nav__bar {
		display: grid;
		grid-template-columns: repeat({{ app.user ? 5 : 4 }}, minmax(0, 1fr));
		align-items: center;
		min-height: 64px;
		padding: 8px;
		border: 1px solid rgba(255, 255, 255, .62);
		border-radius: 999px;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, .82), rgba(255, 255, 255, .52)),
			rgba(255, 255, 255, .58);
		background-color: rgba(255, 255, 255, .72);
		box-shadow: 0 18px 46px rgba(15, 23, 42, .16), inset 0 1px 0 rgba(255, 255, 255, .78), inset 0 -1px 0 rgba(15, 23, 42, .05);
		backdrop-filter: blur(24px) saturate(180%);
		-webkit-backdrop-filter: blur(24px) saturate(180%);
	}

	.native-bottom-nav__item,
	.native-bottom-nav__summary {
		display: flex;
		min-width: 0;
		min-height: 48px;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 3px;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: rgba(51, 65, 85, .62);
		font: inherit;
		font-size: 11px;
		font-weight: 700;
		line-height: 1;
		text-decoration: none;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}

	.native-bottom-nav__item svg,
	.native-bottom-nav__summary svg {
		width: 21px;
		height: 21px;
	}

	.native-bottom-nav__item[aria-current="page"] {
		background: rgba(245, 243, 255, .92);
		color: #5b21b6;
		box-shadow: 0 10px 28px rgba(91, 33, 182, .16), inset 0 1px 0 rgba(255, 255, 255, .72);
	}

	.native-bottom-nav__item--create {
		justify-self: center;
		width: 56px;
		min-height: 56px;
		margin: -18px 0 2px;
		background: #4f46e5;
		color: #ffffff;
		box-shadow: 0 16px 34px rgba(79, 70, 229, .36), inset 0 1px 0 rgba(255, 255, 255, .24);
	}

	.native-bottom-nav__item--create:hover,
	.native-bottom-nav__item--create:focus-visible {
		background: #4338ca;
		color: #ffffff;
	}

	.native-bottom-nav__item--create svg {
		width: 28px;
		height: 28px;
	}

	.native-bottom-nav__item--create span {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.native-bottom-nav__menu {
		position: relative;
	}

	.native-bottom-nav__summary {
		width: 100%;
		list-style: none;
	}

	.native-bottom-nav__summary::-webkit-details-marker {
		display: none;
	}

	.native-bottom-nav__panel {
		position: fixed;
		left: 50%;
		right: auto;
		bottom: calc(92px + env(safe-area-inset-bottom, 0px));
		z-index: 2147483647;
		display: grid;
		width: min(86vw, 320px);
		transform: translateX(-50%);
		gap: 14px;
		padding: 18px 20px 20px;
		border: 1px solid #d9dee8 !important;
		border-radius: 24px;
		background: #ffffff !important;
		background-color: #ffffff !important;
		opacity: 1 !important;
		overflow: hidden;
		isolation: isolate;
		box-shadow: 0 22px 60px rgba(15, 23, 42, .38);
	}

	.native-bottom-nav__panel::before {
		position: absolute;
		inset: 0;
		z-index: -1;
		background: #ffffff;
		content: "";
	}

	[data-theme="dark"] .native-bottom-nav__bar {
		border-color: rgba(129, 140, 248, .28);
		background:
			linear-gradient(135deg, rgba(58, 62, 125, .58), rgba(17, 24, 39, .74)),
			rgba(17, 24, 39, .72);
		background-color: rgba(17, 24, 39, .78);
		box-shadow: 0 18px 46px rgba(15, 23, 42, .34), inset 0 1px 0 rgba(255, 255, 255, .12), inset 0 -1px 0 rgba(0, 0, 0, .18);
	}

	[data-theme="dark"] .native-bottom-nav__item,
	[data-theme="dark"] .native-bottom-nav__summary {
		color: rgba(199, 210, 254, .52);
	}

	[data-theme="dark"] .native-bottom-nav__item[aria-current="page"] {
		background: rgba(245, 243, 255, .94);
		color: #5b21b6;
	}

	[data-theme="dark"] .native-bottom-nav__panel {
		border-color: #374151 !important;
		background: #111827 !important;
		background-color: #111827 !important;
	}

	[data-theme="dark"] .native-bottom-nav__panel::before {
		background: #111827;
	}

	.native-bottom-nav__menu:not([open]) .native-bottom-nav__panel {
		display: none;
	}

	.native-bottom-nav__panel-title {
		color: #64748b;
		font-size: 11px;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: .06em;
	}

	.native-bottom-nav__row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 16px;
		min-height: 46px;
		padding: 0 2px;
		color: #111827;
		font-size: 14px;
		font-weight: 700;
	}

	.native-bottom-nav__row span {
		min-width: 0;
		overflow-wrap: anywhere;
		line-height: 1.2;
	}

	.native-bottom-nav__lang {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 8px;
		position: relative;
		z-index: 1;
	}

	.native-bottom-nav__lang a {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 38px;
		border-radius: 999px;
		background: #eef2f7;
		color: #334155;
		font-size: 13px;
		font-weight: 800;
		text-decoration: none;
	}

	.native-bottom-nav__lang a[aria-current="true"] {
		background: #ede9fe;
		color: #5b21b6;
	}

	[data-theme="dark"] .native-bottom-nav__panel-title {
		color: #9ca3af;
	}

	[data-theme="dark"] .native-bottom-nav__row {
		color: #f9fafb;
	}

	[data-theme="dark"] .native-bottom-nav__lang a {
		background: #1f2937;
		color: #d1d5db;
	}

	[data-theme="dark"] .native-bottom-nav__lang a[aria-current="true"] {
		background: #312e81;
		color: #c4b5fd;
	}
</style>

<nav class="native-bottom-nav" aria-label="Navigation mobile" data-controller="native-menu">
	<div class="native-bottom-nav__bar">
		<a href="{{ path('app_home') }}" class="native-bottom-nav__item" {% if currentRoute == 'app_home' %} aria-current="page" {% endif %}>
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1V10"/>
			</svg>
			<span>{{ 'navbar.home'|trans }}</span>
		</a>

		<a href="{{ path('app_regatta') }}" class="native-bottom-nav__item" {% if currentRoute starts with 'app_regatta' %} aria-current="page" {% endif %}>
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 19h18M5 17l4-12 4 12M9 5l8 12"/>
			</svg>
			<span>{{ 'navbar.my_regattas'|trans }}</span>
		</a>

		{% if app.user %}
			{% if currentRoute == 'app_regatta' %}
				<button type="button" class="native-bottom-nav__item native-bottom-nav__item--create" data-open-dialog="#createRegattaModal" aria-label="Créer une régate">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.5v15m7.5-7.5h-15"/>
					</svg>
					<span>Créer</span>
				</button>
			{% else %}
				<a href="{{ path('app_regatta', {'create': 1}) }}" class="native-bottom-nav__item native-bottom-nav__item--create" aria-label="Créer une régate">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.5v15m7.5-7.5h-15"/>
					</svg>
					<span>Créer</span>
				</a>
			{% endif %}

			<a href="{{ path('app_logout') }}" class="native-bottom-nav__item">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
				</svg>
				<span>{{ 'navbar.logout'|trans }}</span>
			</a>
		{% else %}
			<a href="{{ path('app_login') }}" class="native-bottom-nav__item" {% if currentRoute == 'app_login' %} aria-current="page" {% endif %}>
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a3 3 0 013 3m3 0a6 6 0 01-7.743 5.743L11 18H8v3H5v-3H2v-3l6.257-6.257A6 6 0 1121 10z"/>
				</svg>
				<span>{{ 'navbar.login'|trans }}</span>
			</a>
		{% endif %}

		<details class="native-bottom-nav__menu" data-native-menu-target="details">
			<summary class="native-bottom-nav__summary">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16"/>
				</svg>
				<span>Menu</span>
			</summary>

			<div class="native-bottom-nav__panel">
				<div class="native-bottom-nav__panel-title">Préférences</div>

				<label class="native-bottom-nav__row" for="nativeThemeToggle">
					<span>Thème sombre</span>
					<input id="nativeThemeToggle" type="checkbox" class="toggle toggle-primary toggle-sm" data-theme-target="toggle" value="dark">
				</label>

				<div class="native-bottom-nav__panel-title">Langue</div>
				<div class="native-bottom-nav__lang">
					<a href="{{ path('app_change_language', {'locale': 'fr'}) }}" {% if app.request.locale == 'fr' %} aria-current="true" {% endif %}>FR</a>
					<a href="{{ path('app_change_language', {'locale': 'en'}) }}" {% if app.request.locale == 'en' %} aria-current="true" {% endif %}>EN</a>
				</div>
			</div>
		</details>
	</div>
</nav>
