{# Reusable footer partial - simple, accessible and responsive #}
{% trans_default_domain 'base' %}
<footer class="bg-base-100 border-t border-base-300 mt-auto site-footer">
	<div class="max-w-6xl mx-auto px-4 py-6 flex flex-col md:flex-row items-center justify-between gap-4">
		<a href="/" class="flex items-center gap-2" aria-label="{{ 'base.footer.company'|trans }} - Home">
			<img src="{{ asset('logo.svg') }}" alt="{{ 'base.footer.company'|trans }}" class="h-8 w-auto logo">
			<span class="font-semibold">{{ 'base.footer.company'|trans }}</span>
		</a>

		<div class="text-sm text-base-content/70 text-center md:text-left">
			<div>{{ 'base.footer.copyright'|trans({'%year%': "now"|date('Y')}) }}</div>
			<div class="mt-1">
				<a href="/privacy" class="mr-4 link link-hover">{{ 'base.footer.privacy'|trans }}</a>
				<a href="{{ path('app_contact') }}" class="link link-hover">{{ 'base.footer.contact'|trans }}</a>
			</div>
		</div>

		<div class="text-sm text-base-content/60">{{ 'base.footer.launched_by'|trans }}</div>
	</div>
</footer>
