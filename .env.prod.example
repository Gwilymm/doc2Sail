# Production Environment Variables for Doc2Sail
# Copy this file to .env.local and update the values

###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET=CHANGE_THIS_TO_SOMETHING_RANDOM_AND_SECURE
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# For production, use MySQL/PostgreSQL instead of SQLite
# DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/doc2sail?serverVersion=8.0"
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Use Redis or RabbitMQ for production
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Configure your SMTP server for production
MAILER_DSN=smtp://localhost:1025
MAILER_FROM=noreply@doc2sail.platypus-home.noho.st
###< symfony/mailer ###

###> symfony/mercure-bundle ###
# Use your YunoHost domain
MERCURE_URL=http://localhost:3000/.well-known/mercure
MERCURE_PUBLIC_URL=https://doc2sail.platypus-home.noho.st/.well-known/mercure
MERCURE_JWT_SECRET="CHANGE_THIS_TO_SOMETHING_RANDOM_AND_SECURE"
###< symfony/mercure-bundle ###

###> Web Push Notifications ###
# Generate new VAPID keys for production: php bin/console app:webpush:generate-vapid
VAPID_PUBLIC_KEY="your-production-public-key"
VAPID_PRIVATE_KEY="your-production-private-key"
VAPID_SUBJECT="mailto:admin@doc2sail.platypus-home.noho.st"
###< Web Push Notifications ###
