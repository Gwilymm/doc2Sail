{
    "controllers": {
        "@symfony/ux-notify": {
            "notify": {
                "enabled": true,
                "fetch": "eager"
            }
        },
        "@symfony/ux-turbo": {
            "turbo-core": {
                "enabled": true,
                "fetch": "eager"
            },
            "mercure-turbo-stream": {
                "enabled": false,
                "fetch": "eager"
            }
        },
        "auth": { "enabled": true },
        "document": { "enabled": true },
        "regatta": { "enabled": true },
        "ui": { "enabled": true },
        "notification": { "enabled": true },
        "offline": { "enabled": true },
        "theme": { "enabled": true }
    },
    "entrypoints": []
}
